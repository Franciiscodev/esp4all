// =============================================================================
// ESP4All Core — Template Completo: WorldActors (UE4)
// =============================================================================
// Referência completa para UE4 WorldActors:
//  - UWorld -> PersistentLevel (ou Levels[]) -> Actors[]
//  - LocalPlayer (OwningGameInstance -> LocalPlayers[0] -> PlayerController -> Pawn)
//  - Câmera dual em modo "auto" (tenta ViewMatrix primeiro, fallback CameraCache)
//  - NameSystem (FNamePool UE4.23+ ativo; alternativa GNames comentada)
//  - Filtro O(1) por ClassPrivate (alternativas sentinel e class_name comentadas)
//  - Atributos no AActor (alternativa híbrida player_state e Bone ESP comentados)
//
// No dispositivo Android, envie este arquivo para:
//   /data/local/tmp/ue4_config.json
// =============================================================================
{
    "$schema": "../esp4all.schema.json",
    "meta": {
        "game": "Full UE4 — WorldActors",
        "version": "1.0",
        "engine": "UE4",
        "engine_version": "4.27",
        "arch": 64
    },

    "game": {
        "package_name": "com.example.ue4game", // REQUIRED
        "module_name": "libUE4.so",            // REQUIRED
        "segment": "r-xp"                      // OPTIONAL (default "r-xp")
    },

    "entity_provider": {
        "type": "WorldActors"                  // REQUIRED
    },

    // Origem de todas as chains em globals: moduleBase
    // Nota: em FNamePool inline na .bss, use prefixo '+' (sem deref), ex.: ["+0xE2BA2F0"].
    "globals": {
        "GWorld_chain": [],                    // REQUIRED: ex. ["0xD3A8150"]
        "FNamePool_chain": []                  // REQUIRED quando name_system.enabled == true (ex. ["+0xE2BA2F0"])
        // Fallback opcional caso GWorld falhe:
        // "GEngine_chain": ["0x..."]          // usar junto com a seção "engine_path" abaixo
        // Para UE4 < 4.23 (name_system.type == "GNames"), troque FNamePool_chain por:
        // "GNames_chain": ["0x..."]
    },

    // Fallback opcional GEngine -> GameViewport -> World (descomente se preencher GEngine_chain):
    // "engine_path": {
    //     "EngineGameViewport": "0x808",      // UEngine::GameViewport (0x780–0x850)
    //     "ViewportWorld": "0x70"             // UGameViewportClient::World (0x70–0x80)
    // },

    "world": {
        "PersistentLevel": "0x30",             // REQUIRED: UWorld::PersistentLevel (típico: 0x30 ou 0x90)
        // "Levels": "0x138",                  // OPTIONAL: UWorld::Levels TArray<ULevel*> para Level Streaming
        // "NetDriver": "0x38",                // OPTIONAL: UWorld::NetDriver (resolve PlayerController/Pawn sem LocalPlayers!)
        "LevelActors": "0x98",                 // REQUIRED (externo): ULevel::Actors (típico: 0x98 ou 0xA0)
        "ArrayCountMode": "count",             // "count" | "end_ptr" | "null_terminated"
        "OwningGameInstance": null             // OPTIONAL (necessário p/ LocalPlayer padrão): faixa típica 0x180–0x1D0
    },

    // Resolução do jogador local (necessária para skip_local_player, skip_same_team,
    // distância/max_distance/max_z_delta e CameraCache sem heuristic_pc_scan).
    "local_player": {
        "GameInstance_LocalPlayers": "0x38",   // UGameInstance::LocalPlayers (ABI estável: 0x38)
        "LocalPlayer_PlayerController": "0x30",// UPlayer::PlayerController (ABI estável: 0x30)
        // Alternativa 100% externa via NetDriver (quando LocalPlayers está encriptado):
        // "NetDriver_ServerConnection": "0x78",      // UNetDriver::ServerConnection (UNetConnection*)
        // "ServerConnection_PlayerController": "0x30",// UPlayer::PlayerController (default = LocalPlayer_PlayerController)
        "PlayerController_Pawn": null,         // APlayerController::AcknowledgedPawn (faixa típica: 0x250–0x2C0)
        "PlayerController_CameraManager": null // APlayerController::PlayerCameraManager (faixa típica: 0x2B8–0x390)
        // Alternativas diretas caso LocalPlayers esteja ofuscado:
        // "LocalPawn_chain": ["0x...", "0x0", "0x20"],       // origem: moduleBase
        // "LocalPawn_from_world_chain": ["0x8", "0x48", "0x20"] // origem: UWorld*
    },

    // Em mode = "auto", tenta view_matrix_chain primeiro e cai para camera_cache se falhar.
    "camera": {
        "mode": "auto",                        // "auto" | "matrix" | "camera_cache"
        "matrix_layout": "column_major",       // "column_major" | "row_major"
        "up_axis": "Z",                        // "Z" | "Y"
        "heuristic_pc_scan": false,            // true apenas se LocalPlayers estiver inacessível
        "view_matrix_chain": [],               // REQUIRED se camera_cache não estiver configurado: ex. ["0x...", "0x20", "+0x270"]
        "camera_cache": {
            "CameraCache": null,               // APlayerCameraManager::CameraCachePrivate (0x1AE0–0x2E00)
            "POV": "0x10",                     // FCameraCacheEntry::POV (ABI estável: 0x10)
            "Location": "0x00",                // FMinimalViewInfo::Location
            "Rotation": "0x0C",                // FMinimalViewInfo::Rotation
            "FOV": "0x18",                     // FMinimalViewInfo::FOV
            "FOVRelativeToCache": false
        }
    },

    // Sistema de nomes UE4.23+ (FNamePool).
    // Para jogos UE4 < 4.23 (GNames), troque o bloco inteiro por:
    // "name_system": {
    //     "enabled": true,
    //     "type": "GNames",
    //     "ChunkSize": "0x4000",
    //     "EntryStride": "0x8",
    //     "NameStringOffset": "0xC"
    // },
    "name_system": {
        "enabled": true,
        "type": "FNamePool",
        "allocator": {
            "CurrentBlock": "0x8",
            "Blocks": "0x10",
            "Stride": "0x2"
        },
        "entry": {
            "HeaderSize": "0x2"
        }
    },

    // Filtro de entidades. Apenas o sub-bloco do "mode" ativo deve estar presente.
    // Unidades:
    //   max_distance -> metros (após * DistanceScale)
    //   max_z_delta  -> world units (antes de DistanceScale; 10000 cm = 100 m em UE4)
    "entity_filter": {
        "mode": "class_private",               // "none" | "sentinel" | "class_name" | "class_private"
        "max_distance": 450.0,
        "max_z_delta": 10000.0,
        "skip_zero_pos": true,
        "skip_local_player": true,
        "skip_same_team": false,
        "skip_dead": true,
        "class_private": {
            "offset": "0x10",                  // UObject::ClassPrivate (ABI estável: 0x10)
            "target_names": ["PlayerPawn", "Character"],
            "heuristic_bootstrap": true,       // descobre UClass* por HP/Mesh/PlayerState mesmo sem nomes
            "use_local_pawn_class": true,      // usa UClass* do LocalPawn automaticamente como seed
            "min_hp": 1.0,
            "max_hp": 1000.0
        }
        // --- Alternativa: mode = "sentinel" ---
        // "sentinel": {
        //     "offset": "0x2868",             // ou "chain": ["0x40", "+0xF4"] (origem: AActor*)
        //     "type": "float",                // "float" | "int32"
        //     "value": 479.5,
        //     "epsilon": 0.1
        // }
        // --- Alternativa: mode = "class_name" (requer name_system.enabled = true) ---
        // "class_name": {
        //     "contains": ["PlayerPawn", "Character"],
        //     "exact": [],
        //     "exclude": ["None"]
        // }
    },

    "actor": {
        "ClassPrivate": "0x10",                // UObject::ClassPrivate (ABI estável)
        "FNameIndex": "0x18",                  // UObject::NamePrivate  (ABI estável)

        // AActor::RootComponent: 0x130 (pré-4.14) | 0x158 (4.17–4.19) | 0x1B0 (4.20–4.26) | até 0x278 (4.27)
        "RootComponent": null,                 // REQUIRED
        "PositionSource": "RelativeLocation",  // "RelativeLocation" (default) | "ComponentToWorld"
        "WorldPosition": null,                 // REQUIRED se PositionSource == "RelativeLocation" (ex. "0x11C")
        // "ComponentToWorld": null,           // REQUIRED se PositionSource == "ComponentToWorld" (soma +0x10 automático)

        // Atributos opcionais no AActor (deixe null os que não quiser ler):
        "Health": null,
        "MaxHealth": null,
        "TeamId": null,
        "PlayerName": null,
        "PlayerNameIsUtf16": true,
        "IsBot": null,
        // "PlayerState": null,                // OPTIONAL: necessário se usar overrides em "player_state" abaixo
        // "Controller": null,                 // OPTIONAL: fallback LocalPawn -> Controller

        "BoxBaseOffset": 0.0,                  // world units (cm em UE4)
        "BoxHeight": 165.0,                    // world units (cm em UE4)
        "DistanceScale": 0.01                  // cm -> metros
    },

    // Overrides opcionais para jogos híbridos (ex.: Health no AActor, TeamId/PlayerName no APlayerState):
    // Requer actor.PlayerState preenchido.
    // "player_state": {
    //     "TeamId": null,
    //     "PlayerName": null
    // },

    // Esqueleto opcional de 15 ossos (FTransform). Para ativar, mude enabled para true e descomente os campos:
    "bones": {
        "enabled": false
        // "Mesh": null,                       // ACharacter::Mesh (0x280–0x5E0)
        // "ComponentToWorld": null,           // USceneComponent::ComponentToWorld no Mesh (0x1B0–0x240)
        // "BoneArray": null,                  // USkinnedMeshComponent::CachedComponentSpaceTransforms (0x480–0x880)
        // "BoneArrayBias": "0x0",             // deslocamento extra em bytes sobre BoneArray (ex. "0x30" em alguns jogos)
        // "BoneStride": "0x30",               // sizeof(FTransform) em UE4 ARM64 = 0x30
        // "BoneCountOffset": null,            // default: BoneArray + 0x8 (TArray::Num)
        // "MaxDistance": 200.0,               // metros (após * DistanceScale)
        // "MaxSegmentPixels": 350.0,          // pixels (filtra spikes)
        // // Ordem fixa dos 15 slots:
        // // [Head, Chest, Pelvis, L_Shoulder, R_Shoulder, L_Elbow, R_Elbow,
        // //  L_Wrist, R_Wrist, L_Thigh, R_Thigh, L_Knee, R_Knee, L_Ankle, R_Ankle]
        // "default_profile": [5, 4, 0, 11, 32, 12, 33, 63, 62, 52, 56, 53, 57, 54, 58],
        // "profiles": {
        //     "68": [5, 4, 0, 11, 32, 12, 33, 63, 62, 52, 56, 53, 57, 54, 58]
        // }
    }

    // Rótulos opcionais de veículos e loot (requer name_system.enabled = true):
    // ,
    // "vehicle_map": {
    //     "BP_Vehicle_C": "Vehicle"
    // },
    // "loot_map": {
    //     "BP_Pickup_Rifle_C": "Rifle"
    // },
    //
    // Modo Interno opcional (libesp4all_internal.so — ignorado no executável externo):
    // Permite invocar getters nativos da UE4 e descobrir GameViewport->World via GUObjectArray
    // mantendo o core 100% data-driven (sem acoplar SDK de um jogo específico).
    // "internal": {
    //     "GNames_getter": "0x...",            // Offset de `void* (*)()` que retorna TNameEntryArray*/FNamePool*
    //     "GNames_getter_offset": "0x0",       // Offset somado ao ponteiro retornado (opcional)
    //     "GNames_getter_deref": false,        // true se o getter retornar ponteiro-para-ponteiro
    //     "GetActorArray_fn": "0x...",         // Offset de `void* (*)(uintptr_t level)` -> TArray<AActor*>*
    //     "GUObjectArray": "0x...",            // Offset de FUObjectArray::ObjObjects (requer engine_path.ViewportWorld)
    //     "UObjectArray_Chunked": true,        // true (UE4.21+ FChunkedFixedUObjectArray) | false (flat TUObjectArray)
    //     "ViewportClassName": "GameViewportClient",
    //     "safe_memory_read": true             // true = SAFE_SELF_VM (à prova de SIGSEGV), false = DIRECT_MEMCPY
    // }
}
